# Settings for a hosted Blackline. Set these in your host's "environment variables" page; do not commit a real .env file.

NODE_ENV=production

# The Postgres database. Your host's database page gives you this address.
# Add ?sslmode=require to the end if the host asks for an encrypted connection (most do).
DATABASE_URL=postgres://user:password@host:5432/blackline?sslmode=require

# Who may start a new company on the sign-in page:
#   first   = only the very first one (the owner sets up their own company), then it closes (recommended)
#   closed  = nobody; the administrator adds companies with the admin tool
#   open    = anyone
REGISTRATION=first

# Leave as 1 on a host that puts its own web address in front of the server (almost all do), so sign-in limits count real visitors.
TRUST_PROXY=1

# Optional. The host usually sets PORT itself.
# PORT=3000
